# స్టేజ్ 1: బిల్డ్ స్టేజ్ (వంటగది అనుకోండి)
# ఇక్కడ మనం ఫైల్ ని తయారు చేస్తాం
FROM alpine:latest AS builder

WORKDIR /build

# ఒక టెక్స్ట్ ఫైల్ ని క్రియేట్ చేస్తున్నాం
RUN echo "నమస్కారం! ఇది Multi-stage build ద్వారా వచ్చిన ఫైల్." > hello.txt

# ---------------------------------------------------------

# స్టేజ్ 2: ఫైనల్ స్టేజ్ (సర్వింగ్ టేబుల్ అనుకోండి)
# ఇక్కడ మనం కొత్తగా, క్లీన్ గా ఉన్న ఇమేజ్ ని తీసుకుంటాం
FROM alpine:latest

WORKDIR /app

# మ్యాజిక్ ఇక్కడే జరుగుతుంది: 
# పైన ఉన్న 'builder' స్టేజ్ నుండి కేవలం మనకు కావాల్సిన ఫైల్ ని మాత్రమే కాపీ చేసుకుంటున్నాం.
COPY --from=builder /build/hello.txt .

# కంటైనర్ రన్ అయినప్పుడు ఫైల్ ని చదువుతుంది
CMD ["cat", "hello.txt"]